{
  "name": "cutline",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public_build",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
